---
import BaseLayout from "../layouts/BaseLayout.astro";
import GrpoDiagram from "../components/GrpoDiagram.astro";
import DaggerDiagram from "../components/DaggerDiagram.astro";
import RobotAdapters from "../components/RobotAdapters.astro";
import WamComparison from "../components/WamComparison.astro";
import { profile } from "../data/profile";
import { education, workExperience } from "../data/resume";
import "../styles/home.css";
import "../styles/work-visuals.css";

const externalRel = "noopener noreferrer";
const contactLinks = profile.links.filter((link) => link.label !== "Email");
const linkedInSlug = new URL(profile.sameAs[2]).pathname.split("/").filter(Boolean).at(-1);
const orcidId = new URL(profile.sameAs[3]).pathname.slice(1);
const [currentExperience, ...earlierExperience] = workExperience;
const previousRoles = earlierExperience.map((item) => ({
  ...item,
  years: [...new Set(item.period.match(/\d{4}/g))].join("–"),
}));
const workDiagrams = { grpo: GrpoDiagram, dagger: DaggerDiagram, robots: RobotAdapters };
---

<BaseLayout>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header portfolio-header">
    <div class="portfolio-nav">
      <a class="brand" href="/" aria-label={`${profile.name} homepage`}>
        <img src="/images/favicon.svg?v=jg-2" width="28" height="28" alt="" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="#experience">Experience</a>
        <a href="#research">Research</a>
        <a class="desktop-nav" href="#contact">Contact</a>
        <a class="mobile-nav" href={`mailto:${profile.email}`}>Email</a>
      </nav>
    </div>
  </header>

  <main id="main-content" class="portfolio-layout">
    <aside id="about" class="identity" aria-labelledby="name">
      <h1 id="name">{profile.name}<span lang="zh">{profile.nativeName}</span></h1>
      <p class="identity-role">
        Research Engineer at <a href="https://research.nvidia.com/labs/gear/" target="_blank" rel={externalRel}>NVIDIA GEAR</a>
      </p>
      <p class="identity-statement">
        I work on post-training for generative robot policies, connecting
        reinforcement learning, demonstration data and real-robot execution.
      </p>
      <nav aria-label="Profile links">
        <ul class="identity-links">
          <li><a href={`mailto:${profile.email}`}><span>Email</span><span class="link-detail">Get in touch</span></a></li>
          <li>
            <a
              href={profile.sameAs[0]}
              target="_blank"
              rel={externalRel}
              data-scholar-stats
              data-url={profile.scholarStatsUrl}
              data-state="loading"
              title="Total citations across all publications on Google Scholar"
            >
              <span><span class="scholar-service-prefix">Google </span>Scholar <span class="external-mark" aria-hidden="true">↗</span></span>
              <span class="link-detail" aria-live="polite"><strong data-scholar-total>View</strong> <span class="scholar-label">profile</span></span>
            </a>
          </li>
          <li><a href={profile.sameAs[1]} target="_blank" rel={externalRel}><span>GitHub <span class="external-mark" aria-hidden="true">↗</span></span><span class="link-detail">jiashenggu</span></a></li>
          <li><a href={profile.sameAs[2]} target="_blank" rel={externalRel}><span>LinkedIn <span class="external-mark" aria-hidden="true">↗</span></span><span class="link-detail">{linkedInSlug}</span></a></li>
          <li class="secondary-link"><a href={profile.sameAs[3]} target="_blank" rel={externalRel}><span>ORCID <span class="external-mark" aria-hidden="true">↗</span></span><span class="link-detail">{orcidId}</span></a></li>
        </ul>
      </nav>
    </aside>

    <div class="research-work">
      <section id="experience" aria-labelledby="experience-title">
        <h2 id="experience-title" class="section-label">Current work</h2>
        <div class="current-work-context">
          <a href={currentExperience.href} target="_blank" rel={externalRel}>{currentExperience.organization} GEAR</a>
          <span>{currentExperience.period}</span>
        </div>
        <div class="work-visual-grid">
          {currentExperience.highlights.map((highlight) => {
            const Diagram = workDiagrams[highlight.id];
            return (
              <article class:list={["work-topic", `topic-${highlight.id}`]} aria-labelledby={`work-topic-${highlight.id}`}>
                <h3 id={`work-topic-${highlight.id}`}>{highlight.title}</h3>
                <p class="work-takeaway">{highlight.summary}</p>
                <Diagram />
                <details class="work-details">
                  <summary aria-label={`Technical details: ${highlight.title}`}>Technical details <span aria-hidden="true">+</span></summary>
                  <p>{highlight.detail}</p>
                </details>
              </article>
            );
          })}
        </div>
        <div class="work-figure-notes">
          <p class="platform-credits">
            Platform references:
            <a href="https://galaxea-dynamics.com/products/galaxea-r1-pro-7-dof-dual-arm-wheeled-universal-humanoid-robot" target="_blank" rel={externalRel}>Galaxea</a> ·
            <a href="https://docs.spirit-ai.com/moz1/mechanics.html" target="_blank" rel={externalRel}>Spirit AI</a> ·
            <a href="https://i2rt.com/products/yam-teleoperation-stations" target="_blank" rel={externalRel}>I2RT</a>
          </p>
        </div>
        <p class="previous-experience">
          <span class="previous-label">Previously</span>{" "}
          {previousRoles.map((item, index) => (
            <>
              {index > 0 && " "}
              <a href={item.href} target="_blank" rel={externalRel} title={`${item.role} · ${item.period}`}>{item.organization}</a>
              {" "}({item.years}): {item.detail}
            </>
          ))}
        </p>
      </section>

      <section id="research" aria-labelledby="publications">
        <h2 id="publications" class="section-label">Selected publications</h2>

        <article id="dreamzero" class="research-entry" aria-labelledby="dreamzero-title">
          <p class="entry-meta">2026 · arXiv · Co-author · NVIDIA GEAR</p>
          <h3 id="dreamzero-title" class="project-title">DreamZero</h3>
          <p class="paper-title">World Action Models are Zero-shot Policies</p>
          <p class="research-description">
            DreamZero is a 14B world action model built on a pretrained video
            diffusion backbone.
          </p>
          <WamComparison />
          <p class="paper-results"><span>Results reported by the paper</span><strong>7 Hz</strong> closed-loop control · <strong>&gt;2×</strong> generalization over VLA baselines</p>
          <div class="research-links">
            <a href="https://dreamzero0.github.io/" target="_blank" rel={externalRel}>Project</a>
            <a href="https://arxiv.org/abs/2602.15922" target="_blank" rel={externalRel}>Paper</a>
            <a href="https://github.com/dreamzero0/dreamzero" target="_blank" rel={externalRel}>Code</a>
          </div>
        </article>

        <article id="language-research" class="research-entry" aria-labelledby="robustness-title">
          <p class="entry-meta">Earlier academic research · Findings of ACL 2023 · First author</p>
          <h3 id="robustness-title" class="project-title paper-project-title">Robustness of Learning from Task Instructions</h3>
          <p class="research-description">
            In earlier language-model research, I studied how instruction-following
            models generalize when task instructions are paraphrased, manipulated
            or made more or less concise.
          </p>
          <div class="research-links">
            <a href="https://aclanthology.org/2023.findings-acl.875/" target="_blank" rel={externalRel}>ACL Anthology</a>
            <a href="https://aclanthology.org/2023.findings-acl.875.pdf" target="_blank" rel={externalRel}>Paper PDF</a>
          </div>
        </article>

        <p class="publication-archive"><a href={profile.sameAs[0]} target="_blank" rel={externalRel}>All publications on Google Scholar</a></p>
      </section>

      <section id="education" aria-labelledby="education-title">
        <h2 id="education-title" class="section-label">Education</h2>
        <div class="career-list">
          {education.map((item) => (
            <article class="career-entry">
              <p class="career-period">{item.period}</p>
              <div><h3>{item.institution}</h3><p class="career-role">{item.degree}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section id="contact" aria-labelledby="contact-title">
        <h2 id="contact-title" class="section-label">Contact</h2>
        <a class="contact-address" href={`mailto:${profile.email}`}>{profile.email}</a>
        <nav class="contact-links" aria-label="Contact and professional profiles">
          {contactLinks.map((link) => (
            <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? externalRel : undefined}>{link.label}</a>
          ))}
        </nav>
      </section>
      <footer class="portfolio-footer">© {new Date().getFullYear()} {profile.name}</footer>
    </div>
  </main>
  <script src="../scripts/scholar-stats.ts"></script>
</BaseLayout>
