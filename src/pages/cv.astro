---
import Publications from "../components/Publications.astro";
import Section from "../components/Section.astro";
import { cv } from "../data/cv";
import { profile } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";

const externalRel = "noopener noreferrer";
const profileLinks = profile.links.filter((link) => link.label !== "CV");
---

<BaseLayout
  title={`${profile.name} | CV`}
  description={cv.summary}
  canonicalPath="/cv/"
>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="site-header">
    <nav class="top-nav" aria-label="Primary navigation">
      <a class="brand" href="/" aria-label={`${profile.name} homepage`}>
        <span>{profile.name}</span>
        <small>{profile.nativeName}</small>
      </a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="#work-experience">Work Experience</a></li>
        <li><a href="/#publications">Publications</a></li>
        <li><a href={profile.sameAs[0]} target="_blank" rel={externalRel}>Google Scholar</a></li>
      </ul>
    </nav>
  </header>

  <main id="main-content" class="cv-shell">
    <section class="cv-hero" aria-labelledby="cv-title">
      <p class="eyebrow">Curriculum Vitae</p>
      <h1 id="cv-title">{profile.name}</h1>
      <p class="cv-role">{profile.jobTitle}</p>
      <p class="lead">{cv.summary}</p>
      <div class="inline-links cv-actions">
        <a href="/">Homepage</a>
        {
          profileLinks.map((link) => {
            const isExternal = link.href.startsWith("http");
            return (
              <a
                href={link.href}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? externalRel : undefined}
              >
                {link.label}
              </a>
            );
          })
        }
      </div>
    </section>

    <Section id="work-experience" title="Work Experience" kicker="Experience">
      <div class="cv-entry-list">
        {
          cv.workExperience.map((item) => (
            <article class="cv-entry">
              <div class="cv-entry-heading">
                <h3>{item.organization}</h3>
                <span class="date">{item.period}</span>
              </div>
              <p>
                <strong>{item.role}</strong> · {item.location}
              </p>
              <ul>
                {item.items.map((detail) => <li>{detail}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="research-interests" title="Research Interests" kicker="Focus">
      <ul class="tag-list">
        {cv.researchInterests.map((interest) => <li>{interest}</li>)}
      </ul>
    </Section>

    <Section id="education" title="Education" kicker="Background">
      <div class="cv-entry-list">
        {
          cv.education.map((item) => (
            <article class="cv-entry">
              <div class="cv-entry-heading">
                <h3>{item.institution}</h3>
                <span class="date">{item.period}</span>
              </div>
              <p>{item.degree}</p>
              <ul>
                {item.details.map((detail) => <li>{detail}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="research-experience" title="Research Experience" kicker="Projects">
      <div class="cv-entry-list">
        {
          cv.researchExperience.map((item) => (
            <article class="cv-entry">
              <div class="cv-entry-heading">
                <h3>{item.organization}</h3>
                <span class="date">{item.period}</span>
              </div>
              <p>
                <strong>{item.role}</strong>
                {"mentor" in item && item.mentor ? ` · Mentor: ${item.mentor}` : ""}
              </p>
              <ul>
                {item.items.map((detail) => <li>{detail}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="industry-experience" title="Industry Experience" kicker="Applied work">
      <div class="cv-entry-list">
        {
          cv.industryExperience.map((item) => (
            <article class="cv-entry">
              <div class="cv-entry-heading">
                <h3>{item.organization}</h3>
                <span class="date">{item.period}</span>
              </div>
              <p><strong>{item.role}</strong></p>
              <ul>
                {item.items.map((detail) => <li>{detail}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="publications" title="Publications" kicker="Google Scholar">
      <Publications />
    </Section>

    <Section id="teaching" title="Teaching" kicker="Instruction">
      <div class="cv-entry-list">
        {
          cv.teachingExperience.map((item) => (
            <article class="cv-entry">
              <div class="cv-entry-heading">
                <h3>{item.organization}</h3>
                <span class="date">{item.period}</span>
              </div>
              <p><strong>{item.role}</strong></p>
              <ul>
                {item.items.map((detail) => <li>{detail}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="service" title="Professional Service" kicker="Reviewing">
      <ul class="service-list">
        {cv.professionalService.map((service) => <li>{service}</li>)}
      </ul>
    </Section>

    <Section id="awards" title="Awards" kicker="Recognition">
      <div class="compact-grid">
        {
          cv.awards.map((award) => (
            <article class="compact-card">
              <span class="date">{award.year}</span>
              <h3>{award.title}</h3>
              <p>{award.organization}</p>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="skills" title="Skills" kicker="Tools">
      <div class="skill-groups">
        {
          cv.skills.map((group) => (
            <section class="skill-group" aria-label={group.label}>
              <h3>{group.label}</h3>
              <ul class="tag-list">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </Section>

    <Section id="references" title="References" kicker="Contact">
      <p>{cv.references}</p>
    </Section>
  </main>

  <footer class="site-footer">
    <p>© {new Date().getFullYear()} {profile.name}</p>
  </footer>

</BaseLayout>
